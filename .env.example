# Copy this file to .env for local `netlify dev` use.
# In production, set these as environment variables in the Netlify dashboard
# under Site configuration -> Environment variables. Never commit the real
# values or an actual .env file.

STACKBY_API_KEY=your_stackby_api_key_here
STACKBY_STACK_ID=your_stack_id_here
STACKBY_TABLE_NAME=AppSessions
